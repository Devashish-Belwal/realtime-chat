{
  "name": "realtime-chat",
  "private": true,
  "scripts": {
    "dev:server": "bun --watch apps/server/src/index.ts",
    "dev:client": "bun run --cwd apps/client dev",
    "dev": "concurrently \"bun run dev:server\" \"bun run dev:client\""
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/ws": "^8.5.13",
    "concurrently": "^10.0.5",
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^4.21.2",
    "ws": "^8.18.0"
  }
}